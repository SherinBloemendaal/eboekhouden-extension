{
  "manifest_version": 3,
  "name": "EB Sessions",
  "short_name": "EB Sessions",
  "version": "0.2.9",
  "description": "Unofficial helper for e-Boekhouden.nl: 1Password on the login page, a session switcher, an in-page re-login dialog, faster importing and an optional redesign.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "https://*.e-boekhouden.nl/*"
  ],
  "optional_host_permissions": [
    "https://openrouter.ai/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.e-boekhouden.nl/*"
      ],
      "include_globs": [
        "https://secure*.e-boekhouden.nl/*"
      ],
      "js": [
        "src/main-world.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.e-boekhouden.nl/*"
      ],
      "include_globs": [
        "https://secure*.e-boekhouden.nl/*"
      ],
      "js": [
        "src/shared.js",
        "src/store.js",
        "src/icons.js",
        "src/dialog.js",
        "src/bridge.js",
        "src/request.js",
        "src/login-breakout.js",
        "src/password-fields.js",
        "src/content.js",
        "src/login-page.js",
        "src/import.js",
        "src/features/loader.js",
        "src/features/popups.js",
        "src/features/archive.js",
        "src/features/openposts.js",
        "src/features/remind.js",
        "src/features/templates.js",
        "src/features/ai.js",
        "src/features/invoices.js",
        "src/features/subscriptions.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "EB Sessions",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
