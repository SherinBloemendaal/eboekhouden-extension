{
  "manifest_version": 3,
  "name": "EB Sessions",
  "short_name": "EB Sessions",
  "version": "0.1.0",
  "description": "Unofficial helper for e-Boekhouden.nl: working 1Password autofill, a session switcher and an in-page re-login dialog.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["cookies", "storage"],
  "host_permissions": ["https://*.e-boekhouden.nl/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.e-boekhouden.nl/*"],
      "include_globs": ["https://secure*.e-boekhouden.nl/*"],
      "js": ["src/login-breakout.js", "src/content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
